# 复制本文件为 .env 后再按需修改（.env 已被 .gitignore 忽略，不会提交到 Git）

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=im_redis_123456

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=im_admin
RABBITMQ_PASSWORD=im_mq_123456

# Qdrant (阶段 3 群聊 RAG 使用)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 本地 MySQL 8.0（复用本机已安装的 MySQL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=im_agent_chat
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# 阶段 3 大模型 API（兼容 OpenAI 协议，如 DeepSeek / 通义千问等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
