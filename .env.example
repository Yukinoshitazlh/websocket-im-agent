# 复制本文件为 .env 后再按需修改（.env 已被 .gitignore 忽略，不会提交到 Git）

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=im_redis_123456

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=im_admin
RABBITMQ_PASSWORD=im_mq_123456

# Qdrant (阶段 3 群聊 RAG 使用)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 本地 MySQL 8.0（复用本机已安装的 MySQL；Flyway 启动自动迁移建表）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=im_agent_chat
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# 安全与服务间鉴权（线上生产请务必使用 32 字节以上强随机密钥）
JWT_SECRET=im-agent-local-dev-jwt-secret-key-32bytes!
IM_INTERNAL_TOKEN=im-agent-local-dev-internal-token-32bytes!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# 邮箱注册与防刷（本地默认不发真实邮件，验证码在服务端日志及响应 devCodeHint 回显）
AUTH_REQUIRE_CAPTCHA=true
AUTH_REQUIRE_EMAIL_CODE=true
AUTH_INVITE_CODE=
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pulseim.local

# 阶段 3 大模型 API（兼容 OpenAI 协议，如 DeepSeek / 通义千问等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
