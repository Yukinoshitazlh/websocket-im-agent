# ============================================================================
# PulseIM v2.0 生产环境变量模板（零 Docker 原生部署）
# 部署位置：/etc/pulseim/pulseim.env （chmod 600，属主 pulseim:pulseim，严禁提交到 Git）
# 生成强随机密钥示例：openssl rand -base64 48
# ============================================================================

# --- 数据库（MySQL 8.0，Flyway 启动自动建表与演进） ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=im_agent_chat
MYSQL_USER=pulseim
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD
MYSQL_USE_SSL=false

# --- Redis 7 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# --- RabbitMQ 3.13 ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=im_admin
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD

# --- 核心安全密钥（必须 >= 32 字节强随机字符串，不得沿用开发默认值） ---
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_SECRET_KEY
JWT_EXPIRE_SECONDS=604800
IM_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_64_BYTE_INTERNAL_TOKEN
CORS_ALLOWED_ORIGINS=https://chat.example.com

# --- 邮箱注册与防刷策略 ---
AUTH_REQUIRE_CAPTCHA=true
AUTH_REQUIRE_EMAIL_CODE=true
# 可选：填写非空字符串即开启内测邀请码准入；留空则开放邮箱注册
AUTH_INVITE_CODE=
AUTH_WS_TICKET_TTL_SECONDS=30
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_IP_LOGIN_MAX_PER_MIN=30
AUTH_IP_REGISTER_MAX_PER_HOUR=10
AUTH_IP_EMAIL_CODE_MAX_PER_HOUR=10

# --- SMTP 邮箱发信（支持 QQ邮箱/163/腾讯企业邮/Resend/SES 等） ---
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_USERNAME=your_sender@qq.com
MAIL_PASSWORD=REPLACE_WITH_SMTP_AUTH_CODE
MAIL_FROM=your_sender@qq.com

# --- 文件存储（LOCAL 走服务器磁盘安全下载端点；或切 MINIO/OSS 预签名） ---
STORAGE_MODE=LOCAL
STORAGE_LOCAL_DIR=/var/lib/pulseim/uploads

# --- AI Agent 大模型与配额 ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=deepseek-chat
AGENT_DAILY_QUOTA=50

# --- 服务间内网地址与日志路径 ---
IM_SERVER_URL=http://127.0.0.1:8080
LOGGING_FILE_PATH=/var/log/pulseim
